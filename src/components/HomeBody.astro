---
import type { Locale } from '../i18n/data';
import { t } from '../i18n/data';
import SiteHeader from './SiteHeader.astro';
import SvgLibrary from './SvgLibrary.astro';
import { legalPath } from '../lib/seo';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<SvgLibrary />
<a href="#main" class="skip-link">Skip to content</a>
<SiteHeader locale={locale} />
<main id="main">
<script is:inline type="application/json" id="t10-data" set:html={JSON.stringify({ features: d.features, importSteps: d.importSteps, ai: d.ai, importLabels: d.importLabels, formStatus: d.formStatus, flat: d.flat })}></script>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p  class="eyebrow" set:html={d.flat['hero.eyebrow']}></p>
        <h1  id="hero-title" set:html={d.flat['hero.h1']}></h1>
        <p  class="hero-lead" set:html={d.flat['hero.lead']}></p>
        <div class="hero-actions"><a class="button" href="#demo"><span set:html={d.flat['hero.cta1']}></span> <svg><use href="#diagonal"/></svg></a><a class="text-link" href="#platform"><span set:html={d.flat['hero.cta2']}></span> <svg><use href="#arrow"/></svg></a></div>
        <p class="hero-trust"><span aria-hidden="true">🇨🇭</span> <span set:html={d.flat['hero.trust']}></span></p>
        <p  class="hero-footnote" set:html={d.flat['hero.footnote']}></p>
      </div>
      <figure class="hero-art" aria-hidden="true">
        <div id="hero-art-mount"></div>
        <canvas id="hero-motion" width="1440" height="666" hidden></canvas>
