  <section class="demo section-pad" id="demo" aria-labelledby="demo-title">
    <div class="shell demo-grid"><div class="demo-copy"><p  class="eyebrow" set:html={d.flat['demo.eyebrow']}></p><h2  id="demo-title" set:html={d.flat['demo.h2']}></h2><p set:html={d.flat['demo.lead']}></p><div class="demo-promise"><span set:html={d.flat['demo.promiseLabel']}></span><ul><li set:html={d.flat['demo.promise1']}></li><li set:html={d.flat['demo.promise2']}></li><li set:html={d.flat['demo.promise3']}></li></ul></div></div>
      <form id="demo-form" class="contact-form" novalidate>
        <h3 set:html={d.flat['form.title']}></h3><p  class="form-intro" set:html={d.flat['form.intro']}></p>
        <div class="field"><label  for="full-name" set:html={d.flat['form.fullName']}></label><input id="full-name" name="name" autocomplete="name" required aria-describedby="name-error"><span  class="field-error" id="name-error" hidden set:html={d.flat['form.fullNameErr']}></span></div>
        <div class="field"><label  for="email" set:html={d.flat['form.email']}></label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required aria-describedby="email-error"><span  class="field-error" id="email-error" hidden set:html={d.flat['form.emailErr']}></span></div>
        <div class="field"><label  for="organisation" set:html={d.flat['form.org']}></label><input id="organisation" name="organisation" autocomplete="organization" required aria-describedby="organisation-error"><span  class="field-error" id="organisation-error" hidden set:html={d.flat['form.orgErr']}></span></div>
        <div class="field"><label  for="org-type" set:html={d.flat['form.orgType']}></label><select id="org-type" name="orgType" required aria-describedby="org-type-error">
          <option  value="" set:html={d.flat['form.orgTypeChoose']}></option>
          <option  value="residential" set:html={d.flat['form.orgTypeResidential']}></option>
          <option  value="facility" set:html={d.flat['form.orgTypeFacility']}></option>
          <option  value="unsure" set:html={d.flat['form.orgTypeUnsure']}></option>
        </select><span  class="field-error" id="org-type-error" hidden set:html={d.flat['form.orgTypeErr']}></span></div>
        <details class="optional-fields"><summary><span set:html={d.flat['form.addContext']}></span> <span set:html={d.flat['form.optional']}></span><span class="faq-icon" aria-hidden="true"></span></summary><div class="field"><label  for="role" set:html={d.flat['form.role']}></label><input id="role" name="role" autocomplete="organization-title"></div><div class="field"><label  for="use-case" set:html={d.flat['form.useCase']}></label><textarea id="use-case" name="context" rows="3" placeholder="A property, a process, a question…"></textarea></div></details>
        <p  class="form-preview" set:html={d.flat['form.preview']}></p><input type="text" name="website" id="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true"><button type="submit" class="button submit-button" disabled><span set:html={d.flat['form.submit']}></span> <svg><use href="#diagonal"/></svg></button><p id="form-status" class="form-status" role="status" hidden></p><noscript><p set:html={d.flat['form.noscript']}></p></noscript>
