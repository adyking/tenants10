,662,[318,374,398,422,478,502,582,606,662]],[1422,302,662,[326,334,406,414,486,494,566,638,646]],[1430,294,662,[574,590,606,622,638,654]],[1438,294,662,[358,366,446,454,462,542,550,638,646]]]</script>
      </figure>
    </div>
  </section>
  <div class="shell hero-bottom"><span set:html={d.flat['hero.bottom']}></span><div class="hero-bottom-actions">
    <button class="demo-control" id="replay-hero" type="button" hidden><span aria-hidden="true">↻</span> <span set:html={d.flat['hero.replay']}></span></button>
    <button class="demo-control" id="toggle-hero-lights" type="button" hidden><span set:html={d.flat['hero.pause']}></span></button>
    <a href="#context"><span set:html={d.flat['hero.seeConnect']}></span> <span aria-hidden="true">↓</span></a>
  </div></div>

  <section class="context section-pad" id="context" aria-labelledby="context-title">
    <div class="shell context-grid">
      <div><p  class="eyebrow" set:html={d.flat['context.eyebrow']}></p><h2  id="context-title" set:html={d.flat['context.h2']}></h2></div>
      <div class="context-body"><p  class="lead" set:html={d.flat['context.lead']}></p><p set:html={d.flat['context.body']}></p>
        <div class="context-chain" aria-label="A document becomes a connected record"><span><svg viewBox="0 0 24 24"><path d="M5 21V3h14v18M2 21h20M9 7h1m4 0h1M9 11h1m4 0h1M9 15h1m4 0h1"/></svg><span set:html={d.flat['context.chain1']}></span></span><b aria-hidden="true">→</b><span><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM10 11h5m-5 4h5"/></svg><span set:html={d.flat['context.chain2']}></span></span><b aria-hidden="true">→</b><span><svg viewBox="0 0 24 24"><path d="M4 18h16M4 12h10M4 6h6"/></svg><span set:html={d.flat['context.chain3']}></span></span></div>
      </div>
    </div>
  </section>

  <section class="platform section-pad" id="platform" aria-labelledby="platform-title">
    <div class="shell">
      <div class="section-heading"><div><p  class="eyebrow" set:html={d.flat['platform.eyebrow']}></p><h2  id="platform-title" set:html={d.flat['platform.h2']}></h2></div><p set:html={d.flat['platform.intro']}></p></div>
      <div class="product-layout">
        <div class="feature-index" role="group" aria-label="Product capabilities">
          <button class="feature-choice" id="feature-property" aria-pressed="false" aria-controls="product-view" data-feature="property"><span  class="feature-name" set:html={d.flat['feature.property.name']}></span><span  class="feature-description" set:html={d.flat['feature.property.desc']}></span><svg class="feature-arrow" aria-hidden="true"><use href="#arrow"/></svg></button>
          <button class="feature-choice active" id="feature-maintenance" aria-pressed="true" aria-controls="product-view" data-feature="maintenance"><span  class="feature-name" set:html={d.flat['feature.maintenance.name']}></span><span  class="feature-description" set:html={d.flat['feature.maintenance.desc']}></span><svg class="feature-arrow" aria-hidden="true"><use href="#arrow"/></svg></button>
          <button class="feature-choice" id="feature-contracts" aria-pressed="false" aria-controls="product-view" data-feature="contracts"><span  class="feature-name" set:html={d.flat['feature.contracts.name']}></span><span  class="feature-description" set:html={d.flat['feature.contracts.desc']}></span><svg class="feature-arrow" aria-hidden="true"><use href="#arrow"/></svg></button>
          <button class="feature-choice" id="feature-insights" aria-pressed="false" aria-controls="product-view" data-feature="insights"><span  class="feature-name" set:html={d.flat['feature.insights.name']}></span><span  class="feature-description" set:html={d.flat['feature.insights.desc']}></span><svg class="feature-arrow" aria-hidden="true"><use href="#arrow"/></svg></button>
          <a class="text-link feature-cta" href="#demo"><span set:html={d.flat['platform.cta']}></span> <svg><use href="#arrow"/></svg></a>
        </div>
        <div class="product-view" id="product-view" role="region" aria-label="Selected capability">
          <div class="capture-top"><span  class="capture-label" set:html={d.flat['productView.label']}></span><span set:html={d.flat['productView.badge']}></span></div>
          <div class="capture-content" id="capture-content">
            <div class="capture-note"><span class="tiny-label" id="capture-kicker">{d.features.maintenance.kicker}</span><h3 id="capture-title">{d.features.maintenance.title}</h3><p id="capture-description">{d.features.maintenance.description}</p></div>
            <div class="capture-image-wrap">
              <img id="capture-image" src={d.features.maintenance.image} alt="" class="capture-image">
            </div>
          </div>
          <p class="capture-caption" id="capture-caption">{d.features.maintenance.caption}</p>
        </div>
      </div>
      <div class="platform-note"><span class="blue-dot" aria-hidden="true"></span><p set:html={d.flat['platform.note']}></p></div>
    </div>
  </section>

  <section class="intelligence section-pad" id="intelligence" aria-labelledby="intelligence-title">
    <div class="shell intelligence-grid">
      <div class="intelligence-copy"><p class="eyebrow"><span set:html={d.flat['intelligence.eyebrow']}></span> <span  class="badge" set:html={d.flat['intelligence.badge']}></span></p><h2  id="intelligence-title" set:html={d.flat['intelligence.h2']}></h2><p set:html={d.flat['intelligence.lead']}></p><p  class="ai-limit" set:html={d.flat['intelligence.limit']}></p></div>
      <div class="ai-demo" data-ai-phase="answer">
        <div class="demo-heading ai-chat-header">
          <strong set:html={d.flat['ai.assistantLabel']}></strong><span set:html={d.flat['ai.exampleConv']}></span>
        </div>
        <div class="ai-chat-body">
          <p class="ai-chat-context"><span set:html={d.flat['ai.sampleRecord']}></span> <span set:html={d.flat['ai.sampleRecordValue']}></span></p>
          <div class="ai-thread" aria-label="Example conversation">
            <p class="ai-sent" id="ai-sent"><span  class="sr-only" set:html={d.flat['ai.srExampleQuestion']}></span><span id="ai-sent-text">{d.ai.samplePrompt}</span></p>
            <div class="ai-reply-slot">
              <div class="ai-thinking" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="ai-answer" id="ai-answer">
                <p  class="ai-speaker" set:html={d.flat['ai.speaker']}></p>
                <p set:html={d.flat['ai.answer1']}></p>
                <p set:html={d.flat['ai.answer2']}></p>
                <a href="#ai-record" class="source-reference"><span set:html={d.flat['ai.sourceLink']}></span> <svg aria-hidden="true"><use href="#arrow"/></svg></a>
              </div>
            </div>
          </div>
          <div class="prompt-box" aria-hidden="true">
            <span id="typed-prompt">{d.ai.draftPlaceholder}</span><span class="prompt-cursor"></span>
            <span class="prompt-arrow"><svg><use href="#arrow"/></svg></span>
          </div>
          <div class="ai-demo-bottom"><button class="play-button demo-control" id="play-ai"><svg aria-hidden="true"><use href="#play"/></svg><span set:html={d.flat['ai.replay']}></span></button><span set:html={d.flat['ai.exampleConv']}></span></div>
          <p class="sr-only" id="ai-status" role="status"></p>
          <div id="ai-record" class="source-expanded" hidden tabindex="-1"><strong set:html={d.flat['ai.sourceTitle']}></strong><p set:html={d.flat['ai.sourceBody']}></p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="communication section-pad" id="communication" aria-labelledby="communication-title">
    <div class="shell questions-grid">
      <div><p  class="eyebrow" set:html={d.flat['comm.eyebrow']}></p><h2  id="communication-title" set:html={d.flat['comm.h2']}></h2><p set:html={d.flat['comm.lead']}></p></div>
      <div class="comm-content">
        <ol class="adoption-steps">
          <li><span>01</span><div><strong set:html={d.flat['comm.f1.title']}></strong><p set:html={d.flat['comm.f1.body']}></p></div></li>
          <li><span>02</span><div><strong set:html={d.flat['comm.f2.title']}></strong><p set:html={d.flat['comm.f2.body']}></p></div></li>
          <li><span>03</span><div><strong set:html={d.flat['comm.f3.title']}></strong><p set:html={d.flat['comm.f3.body']}></p></div></li>
          <li><span>04</span><div><strong set:html={d.flat['comm.f4.title']}></strong><p set:html={d.flat['comm.f4.body']}></p></div></li>
        </ol>
        <figure class="comm-phone"><img src="/assets/screenshots/tenant-app-home.jpg" alt="" loading="lazy"><figcaption set:html={d.flat['comm.phoneCaption']}></figcaption></figure>
      </div>
    </div>
  </section>

  <section class="adoption section-pad" id="adoption" aria-labelledby="adoption-title">
    <div class="shell">
      <div class="section-heading"><div><p  class="eyebrow" set:html={d.flat['adoption.eyebrow']}></p><h2  id="adoption-title" set:html={d.flat['adoption.h2']}></h2></div><p set:html={d.flat['adoption.intro']}></p></div>
      <div class="adoption-layout">
        <div class="adoption-copy"><h3 set:html={d.flat['adoption.h3']}></h3><p set:html={d.flat['adoption.p']}></p><ol class="adoption-steps"><li><span>01</span><div><strong set:html={d.flat['adoption.s1.title']}></strong><p set:html={d.flat['adoption.s1.body']}></p></div></li><li><span>02</span><div><strong set:html={d.flat['adoption.s2.title']}></strong><p set:html={d.flat['adoption.s2.body']}></p></div></li><li><span>03</span><div><strong set:html={d.flat['adoption.s3.title']}></strong><p set:html={d.flat['adoption.s3.body']}></p></div></li></ol><p  class="fit-copy" set:html={d.flat['adoption.fit']}></p></div>
        <div class="import-demo" aria-label="Conceptual spreadsheet import demonstration">
          <div class="demo-heading"><span set:html={d.flat['importDemo.heading']}></span><span  class="badge" set:html={d.flat['importDemo.badge']}></span></div>
          <div class="import-stepper" role="group" aria-label="Illustrative import stages"><button data-import-step="0" aria-pressed="true"><span class="step-num">1</span><span set:html={d.flat['importStepper.choose']}></span></button><span class="import-connector" aria-hidden="true"></span><button data-import-step="1" aria-pressed="false"><span class="step-num">2</span><span set:html={d.flat['importStepper.review']}></span></button><span class="import-connector" aria-hidden="true"></span><button data-import-step="2" aria-pressed="false"><span class="step-num">3</span><span set:html={d.flat['importStepper.organise']}></span></button></div>
          <div class="import-stage" id="import-stage" data-stage="0">
            <div class="file-caption"><span class="file-icon" aria-hidden="true">X</span><div><strong>property-sample.xlsx</strong><span set:html={d.flat['importDemo.fileDesc']}></span></div><span class="file-status" id="file-status">{d.importSteps[0].status}</span></div>
            <div class="sample-table"><div class="table-head" id="sample-table-head"><span>{d.importSteps[0].headers[0]}</span><span>{d.importSteps[0].headers[1]}</span><span>{d.importSteps[0].headers[2]}</span></div><div class="sample-row"><span>Building A</span><span>3B</span><span>CT-001</span></div><div class="sample-row"><span>Building B</span><span>2A</span><span>CT-002</span></div><div class="sample-row"><span>Building C</span><span>1A</span><span>CT-003</span></div></div>
            <div class="import-explanation" aria-live="polite"><span class="import-symbol" id="import-symbol" aria-hidden="true">{d.importSteps[0].symbol}</span><div><h4 id="import-stage-title">{d.importSteps[0].title}</h4><p id="import-stage-copy">{d.importSteps[0].copy}</p></div></div>
          </div>
          <div class="import-controls"><button class="play-button demo-control" id="play-import"><svg><use href="#play"/></svg><span set:html={d.flat['import.play']}></span></button><button class="reset-button demo-control" id="reset-import" aria-label="Reset import demonstration">↺</button></div>
          <p  class="concept-note" set:html={d.flat['import.conceptNote']}></p>
        </div>
      </div>
    </div>
  </section>

  <section class="questions section-pad" id="questions" aria-labelledby="questions-title">
    <div class="shell questions-grid"><div><p  class="eyebrow" set:html={d.flat['questions.eyebrow']}></p><h2  id="questions-title" set:html={d.flat['questions.h2']}></h2><p set:html={d.flat['questions.lead']}></p><a class="text-link" href="#demo"><span set:html={d.flat['questions.cta']}></span> <svg><use href="#arrow"/></svg></a></div>
      <div class="faq">
        <details><summary><span set:html={d.flat['faq.q1']}></span><svg class="faq-chevron" aria-hidden="true"><use href="#faq-chevron-icon"/></svg></summary><p set:html={d.flat['faq.a1']}></p></details>
        <details><summary><span set:html={d.flat['faq.q2']}></span><svg class="faq-chevron" aria-hidden="true"><use href="#faq-chevron-icon"/></svg></summary><p set:html={d.flat['faq.a2']}></p></details>
