---
import SiteHeader from '../components/SiteHeader.astro';
import type { Locale } from '../i18n/data';
import type { LegalDocKey } from '../i18n/legalMeta';
import { LEGAL_META } from '../i18n/legalMeta';
import { SITE_URL, OG_LOCALE, legalPath, localePath } from '../lib/seo';

interface Props {
  locale: Locale;
  docKey: LegalDocKey;
  lastUpdated?: string;
}
const { locale, docKey, lastUpdated } = Astro.props;
const meta = LEGAL_META[locale];
const docMeta = meta.docs[docKey];

const title = `${docMeta.title} — Tenants10`;
const canonicalUrl = new URL(legalPath(locale, docKey), SITE_URL).toString();
// TODO: once DE/FR/IT translations of this doc are live, switch to
// hreflangLinks((l) => legalPath(l, docKey)) for all 4 locales. Until then,
// only English exists, so only advertise that (no x-default/de/fr/it
// pointing at pages that don't exist yet).
const alt = [{ hreflang: 'en', href: new URL(legalPath('en', docKey), SITE_URL).toString() }];
const ogImage = new URL('/assets/og-image.jpg', SITE_URL).toString();
const htmlLang = locale === 'en' ? 'en-GB' : locale;

// TODO: once DE/FR/IT translations of this doc are live, switch these back
// to legalPath(l, docKey) for each locale. Until then, legal pages only
// exist in English, so the other languages fall back to that locale's
// home page instead of 404ing.
const langLinks: Record<Locale, string> = {
  en: legalPath('en', docKey),
  de: localePath('de'),
  fr: localePath('fr'),
  it: localePath('it'),
};
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={docMeta.description}>
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl}>
  {alt.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Tenants10">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={docMeta.description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content={OG_LOCALE[locale]}>
  <link rel="stylesheet" href="/styles.css?v=21">
  <link rel="stylesheet" href="/legal.css">
  <script src="/app.js?v=6" defer></script>
</head>
<body>
  <SiteHeader locale={locale} langLinks={langLinks} />
  <main class="legal-main">
    <a class="legal-back" href={locale === 'en' ? '/' : `/${locale}/`}>{meta.backLink}</a>
    <h1>{docMeta.title}</h1>
    {lastUpdated && <p class="legal-updated">{meta.lastUpdatedLabel} {lastUpdated}</p>}
    <slot />
  </main>
</body>
</html>
