---
import type { Locale } from '../i18n/data';
import { SITE_URL, OG_LOCALE, localePath, hreflangLinks } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;

const canonicalUrl = new URL(localePath(locale), SITE_URL).toString();
const alt = hreflangLinks(localePath);
const ogImage = new URL('/assets/og-image.jpg', SITE_URL).toString();

const htmlLang = locale === 'en' ? 'en-GB' : locale;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tenants10',
  legalName: 'Tenants10 KlG',
  url: SITE_URL + '/',
  logo: new URL('/assets/tenants10-logo.svg', SITE_URL).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Grütstrasse 28',
    addressLocality: 'Adliswil',
    postalCode: '8134',
    addressCountry: 'CH',
  },
  vatID: 'CHE-431.347.772',
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tenants10',
  description,
  url: canonicalUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: locale,
  provider: { '@type': 'Organization', name: 'Tenants10', url: SITE_URL + '/' },
};
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl}>
  {alt.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Tenants10">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="750">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content={OG_LOCALE[locale]}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <link rel="stylesheet" href="/styles.css?v=27">
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  <script src="/app.js?v=6" defer></script>
</head>
<body>
  <slot />
</body>
</html>
