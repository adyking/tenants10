---
import Layout from '../layouts/Layout.astro';
import LegalHeader from '../components/LegalHeader.astro';
---

<Layout title="Imprint">
  <main class="bg-white">
    <LegalHeader lang="en" />
    <section class="max-w-4xl mx-auto px-6 py-20 text-text">
      <h1 class="text-4xl font-bold mb-4">Imprint</h1>

      <div class="space-y-6">
        <section>
          <h2 class="text-2xl font-semibold mb-3">Company Information</h2>
          <p>Tenants10 KlG</p>
          <p>Legal form: Kollektivgesellschaft (collective partnership)</p>
          <p>Grütstrasse 28</p>
          <p>8134 Adliswil</p>
          <p>Switzerland</p>
          <p>UID: CHE-431.347.772</p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Contact</h2>
          <p>Email: support@tenants10.com</p>
          <p>Website: https://tenants10.com</p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Disclaimer</h2>
          <p>
            Despite careful control of content, we assume no liability for external
            links or third-party content.
          </p>
        </section>
      </div>
    </section>
  </main>
</Layout>