---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cookie Policy">
  <main class="bg-white">
    <section class="max-w-4xl mx-auto px-6 py-20 text-text">
      <h1 class="text-4xl font-bold mb-4">Cookie Policy</h1>
      <p class="text-text-muted mb-10">
        <strong>Last updated:</strong> July 2, 2026
      </p>

      <div class="space-y-8">
        <p>
          This Cookie Policy explains how Tenants10 uses cookies and similar
          technologies on our website.
        </p>

        <section>
          <h2 class="text-2xl font-semibold mb-3">What Are Cookies?</h2>
          <p>
            Cookies are small text files stored on your device that help websites
            function and improve user experience.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">How We Use Cookies</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li>Remember preferences</li>
            <li>Improve performance</li>
            <li>Analyze traffic and usage</li>
            <li>Enhance security</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Managing Cookies</h2>
          <p>
            You can disable cookies through your browser settings, though some
            website features may stop functioning correctly.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Contact</h2>
          <p>
            Questions? Contact
            <a href="mailto:support@tenants10.com" class="text-primary font-medium">
              support@tenants10.com
            </a>
          </p>
        </section>
      </div>
    </section>
  </main>
</Layout>