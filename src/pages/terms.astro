---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service">
  <main class="bg-white">
    <section class="max-w-4xl mx-auto px-6 py-20 text-text">
      <h1 class="text-4xl font-bold mb-4">Terms of Service</h1>
      <p class="text-text-muted mb-10">
        <strong>Last updated:</strong> July 2, 2026
      </p>

      <div class="space-y-8">
        <p>
          These Terms of Service govern your use of Tenants10’s website,
          mobile applications, and related services.
        </p>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Acceptance of Terms</h2>
          <p>
            By accessing or using Tenants10, you agree to be bound by these Terms.
            If you do not agree, please do not use our services.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Use of Service</h2>
          <p>
            You agree to use the platform only for lawful purposes and in accordance
            with applicable regulations.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Accounts</h2>
          <p>
            Users are responsible for maintaining the confidentiality of account
            credentials and for all activities under their account.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Limitation of Liability</h2>
          <p>
            Tenants10 shall not be liable for indirect, incidental, or consequential
            damages arising from the use of the service.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Changes</h2>
          <p>
            We may modify these terms at any time. Updated versions will be posted
            on this page.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold mb-3">Contact</h2>
          <p>
            For questions regarding these Terms, contact
            <a href="mailto:support@tenants10.com" class="text-primary font-medium">
              support@tenants10.com
            </a>
          </p>
        </section>
      </div>
    </section>
  </main>
</Layout>